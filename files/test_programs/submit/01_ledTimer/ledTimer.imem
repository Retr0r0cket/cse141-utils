// Turn on an LED with the cycle counter's COUNT between 1000 and 1020
//
// Approach: poll the cycle counter instead of counting a delay loop, so the
// timing doesn't depend on how many cycles each instruction takes. The loop
// reads COUNT (0x4000_2000) until it's at least 999, then writes 1 to the
// LED register (0x4000_1000), turning LED 0 on.
//
// Why 999: the LED write's access cycle comes 7 cycles after the read that
// ends the loop (the compare, the branch, then the store through the APB
// bridge, on the simple 5-stage core), and that read can see any COUNT from
// the threshold to 8 past it (the loop takes 9 cycles). So the LED turns on
// with COUNT from 1006 to 1014: 6 cycles of room either way for a core
// that's faster or slower.
@00000000
40 21        // movs r1, #0x40
09 03        // lsls r1, r1, #12      -> r1 = 0x40000
02 31        // adds r1, #2
09 03        // lsls r1, r1, #12      -> r1 = 0x40002000 (COUNT)
40 23        // movs r3, #0x40
1B 03        // lsls r3, r3, #12
01 33        // adds r3, #1
1B 03        // lsls r3, r3, #12      -> r3 = 0x40001000 (LEDs)
01 22        // movs r2, #1           -> LED 0
FA 24        // movs r4, #250
A4 00        // lsls r4, r4, #2       -> r4 = 1000
01 3C        // subs r4, #1           -> r4 = 999
08 68        // ldr  r0, [r1, #0]     <- loop: read COUNT
A0 42        // cmp  r0, r4
FC D3        // bcc  loop             -> until COUNT >= 999
1A 60        // str  r2, [r3, #0]     -> LED 0 on
00 DE        // udf  #0               -> halt
