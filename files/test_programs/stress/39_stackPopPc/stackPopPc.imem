04 36        // 00b2: adds   r6, #4
35 60        // 00b4: str    r5, [r6, #0]
04 36        // 00b6: adds   r6, #4
37 60        // 00b8: str    r7, [r6, #0]
04 36        // 00ba: adds   r6, #4
0B 20        // 00bc: movs   r0, #11
FF F7        // 00be: bl     sum
C7 FF        // 00c0: 
30 60        // 00c2: str    r0, [r6, #0]
04 36        // 00c4: adds   r6, #4
34 60        // 00c6: str    r4, [r6, #0]
04 36        // 00c8: adds   r6, #4
69 46        // 00ca: mov    r1, r13
31 60        // 00cc: str    r1, [r6, #0]
04 36        // 00ce: adds   r6, #4
02 4B        // 00d0: ldr    r3, =pool1
98 47        // 00d2: blx    r3
30 60        // 00d4: str    r0, [r6, #0]
04 36        // 00d6: adds   r6, #4
02 E0        // 00d8: b      go2
00 BF        // 00da: nop    (align)
// pool1:
37 00        // 00dc: .word  mid + 1
00 00        // 00de: 
// go2:
02 48        // 00e0: ldr    r0, =pool3
01 B4        // 00e2: push   {r0}
00 BD        // 00e4: pop    {pc}
01 DE        // 00e6: udf    #1          @ must never run
01 DE        // 00e8: udf    #1          @ must never run
00 BF        // 00ea: nop    (align)
// pool3:
F1 00        // 00ec: .word  target4 + 1
00 00        // 00ee: 
