20 26        // 0014: movs   r6, #32
36 02        // 0016: lsls   r6, r6, #8
36 02        // 0018: lsls   r6, r6, #8
36 02        // 001a: lsls   r6, r6, #8
00 27        // 001c: movs   r7, #0
07 E0        // 001e: b      main
01 DE        // 0020: udf    #1          @ must never run
// sub_lo:
01 37        // 0022: adds   r7, #1
70 47        // 0024: bx     r14
01 DE        // 0026: udf    #1          @ must never run
00 BF        // 0028: nop
