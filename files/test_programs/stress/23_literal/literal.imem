// ADR and LDR (literal), from either half of a word: PC read as Align(PC + 4, 4)
// 
// Made by tools/gen_stress.py (just gen-stress); expected outputs from the
// golden model, tools/thumb_iss.py. Results go to SRAM from 0x20000000.
@00000000
08 20        // 0000: movs   r0, #8
80 46        // 0002: mov    r8, r0
04 20        // 0004: movs   r0, #4
81 46        // 0006: mov    r9, r0
02 20        // 0008: movs   r0, #2
82 46        // 000a: mov    r10, r0
01 20        // 000c: movs   r0, #1
83 46        // 000e: mov    r11, r0
00 20        // 0010: movs   r0, #0
84 46        // 0012: mov    r12, r0
20 26        // 0014: movs   r6, #32
36 02        // 0016: lsls   r6, r6, #8
36 02        // 0018: lsls   r6, r6, #8
36 02        // 001a: lsls   r6, r6, #8
00 A2        // 001c: adr    r2, #0
32 60        // 001e: str    r2, [r6, #0]
04 36        // 0020: adds   r6, #4
00 4A        // 0022: ldr    r2, [pc, #0]
32 60        // 0024: str    r2, [r6, #0]
04 36        // 0026: adds   r6, #4
01 A2        // 0028: adr    r2, #4
32 60        // 002a: str    r2, [r6, #0]
04 36        // 002c: adds   r6, #4
01 4A        // 002e: ldr    r2, [pc, #4]
32 60        // 0030: str    r2, [r6, #0]
04 36        // 0032: adds   r6, #4
02 A2        // 0034: adr    r2, #8
32 60        // 0036: str    r2, [r6, #0]
04 36        // 0038: adds   r6, #4
02 4A        // 003a: ldr    r2, [pc, #8]
32 60        // 003c: str    r2, [r6, #0]
04 36        // 003e: adds   r6, #4
03 A2        // 0040: adr    r2, #12
32 60        // 0042: str    r2, [r6, #0]
04 36        // 0044: adds   r6, #4
03 4A        // 0046: ldr    r2, [pc, #12]
32 60        // 0048: str    r2, [r6, #0]
04 36        // 004a: adds   r6, #4
00 BF        // 004c: nop
00 A2        // 004e: adr    r2, #0
32 60        // 0050: str    r2, [r6, #0]
04 36        // 0052: adds   r6, #4
00 4A        // 0054: ldr    r2, [pc, #0]
32 60        // 0056: str    r2, [r6, #0]
04 36        // 0058: adds   r6, #4
00 BF        // 005a: nop
01 A2        // 005c: adr    r2, #4
32 60        // 005e: str    r2, [r6, #0]
04 36        // 0060: adds   r6, #4
01 4A        // 0062: ldr    r2, [pc, #4]
32 60        // 0064: str    r2, [r6, #0]
04 36        // 0066: adds   r6, #4
00 BF        // 0068: nop
02 A2        // 006a: adr    r2, #8
32 60        // 006c: str    r2, [r6, #0]
04 36        // 006e: adds   r6, #4
02 4A        // 0070: ldr    r2, [pc, #8]
32 60        // 0072: str    r2, [r6, #0]
04 36        // 0074: adds   r6, #4
00 BF        // 0076: nop
03 A2        // 0078: adr    r2, #12
32 60        // 007a: str    r2, [r6, #0]
04 36        // 007c: adds   r6, #4
03 4A        // 007e: ldr    r2, [pc, #12]
32 60        // 0080: str    r2, [r6, #0]
04 36        // 0082: adds   r6, #4
10 E0        // 0084: b      pool1
00 BF        // 0086: nop    (align)
11 11        // 0088: .word  0x11111111
11 11        // 008a: 
22 22        // 008c: .word  0x22222222
22 22        // 008e: 
33 33        // 0090: .word  0x33333333
33 33        // 0092: 
44 44        // 0094: .word  0x44444444
44 44        // 0096: 
55 55        // 0098: .word  0x55555555
55 55        // 009a: 
