// The cycle counter: CLEAR, reads back to back, a timed loop, writes to COUNT and to
// offsets that aren't registers ignored, those offsets and CLEAR read 0. COUNT is
// checked only by ranges, so any core's timing gives the same outputs.
// 
// Made by tools/gen_stress.py (just gen-stress); expected outputs from the
// golden model, tools/thumb_iss.py. Results go to SRAM from 0x20000000.
@00000000
08 20        // 0000: movs   r0, #8
80 46        // 0002: mov    r8, r0
04 20        // 0004: movs   r0, #4
81 46        // 0006: mov    r9, r0
02 20        // 0008: movs   r0, #2
82 46        // 000a: mov    r10, r0
01 20        // 000c: movs   r0, #1
83 46        // 000e: mov    r11, r0
00 20        // 0010: movs   r0, #0
84 46        // 0012: mov    r12, r0
20 26        // 0014: movs   r6, #32
36 02        // 0016: lsls   r6, r6, #8
36 02        // 0018: lsls   r6, r6, #8
36 02        // 001a: lsls   r6, r6, #8
40 24        // 001c: movs   r4, #64
24 02        // 001e: lsls   r4, r4, #8
24 02        // 0020: lsls   r4, r4, #8
20 34        // 0022: adds   r4, #32
24 02        // 0024: lsls   r4, r4, #8
64 60        // 0026: str    r4, [r4, #4]
21 68        // 0028: ldr    r1, [r4, #0]
40 23        // 002a: movs   r3, #64
99 42        // 002c: cmp    r1, r3
00 D3        // 002e: bcc    ok1
01 DE        // 0030: udf    #1          @ must never run
// ok1:
C0 23        // 0032: movs   r3, #192
33 60        // 0034: str    r3, [r6, #0]
04 36        // 0036: adds   r6, #4
20 68        // 0038: ldr    r0, [r4, #0]
21 68        // 003a: ldr    r1, [r4, #0]
0A 1A        // 003c: subs   r2, r1, r0
01 23        // 003e: movs   r3, #1
9A 42        // 0040: cmp    r2, r3
00 D2        // 0042: bcs    ok2
01 DE        // 0044: udf    #1          @ must never run
// ok2:
C8 23        // 0046: movs   r3, #200
9A 42        // 0048: cmp    r2, r3
