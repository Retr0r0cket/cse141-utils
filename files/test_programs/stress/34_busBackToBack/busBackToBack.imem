44 33        // 0062: adds   r3, #68
1B 02        // 0064: lsls   r3, r3, #8
44 33        // 0066: adds   r3, #68
5A 27        // 0068: movs   r7, #90
3F 02        // 006a: lsls   r7, r7, #8
5A 37        // 006c: adds   r7, #90
